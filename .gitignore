agent/IDENTITY.md
agent/config/*.local.json

# Personal notes and QA scratch — never published. The release gates
# (Gate P/PF) treat `ls-files --cached --others --exclude-standard` as the
# publish path set, so these must not appear in it.
handoff_*.md
status_panel.txt
how-i-work.html
artifacts/observation/
